<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <EnableNETAnalyzers>True</EnableNETAnalyzers>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
        <Nullable>enable</Nullable>
        <PackageId>Roblox.API.NET</PackageId>
        <Version>0.1.0</Version>
        <Title>A roblox client that accesses Cloud API</Title>
        <Authors>SimobiSirOP</Authors>
        <Copyright>Copyright © SimobiSirOP 2026</Copyright>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/SimobiSirOP/Roblox.API.NET</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/SimobiSirOP/Roblox.API.NET.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Description>A async API Wrapper to access Roblox Cloud API</Description>
        <PackageTags>roblox;api;wrapper;server;roblox_cloud;dotnet;c#;webapi</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <AssemblyName>RobloxCloudApi</AssemblyName>
        <RootNamespace>RobloxCloudApi</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
        
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="5.0.0" />
        <PackageReference Include="System.Linq.Async" Version="5.0.0" />
        <PackageReference Include="System.Memory" Version="4.5.4" />
        <PackageReference Include="System.Text.Json" Version="5.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md">
            <Pack>True</Pack>
            <PackagePath>/</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="src\APIRequests\UsersApi\Requests\" />
    </ItemGroup>

</Project>
